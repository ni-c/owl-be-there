{
  "name": "@owl/shared",
  "version": "0.4.2",
  "private": true,
  "description": "Domain logic, limits and validation schemas shared by the server and the client",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./home-texts": {
      "types": "./dist/home-texts.d.ts",
      "import": "./dist/home-texts.js"
    },
    "./home/*": {
      "types": "./dist/home/*.d.ts",
      "import": "./dist/home/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
