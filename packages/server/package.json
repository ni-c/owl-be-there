{
  "name": "@owl/server",
  "version": "0.1.1",
  "private": true,
  "description": "Owl Be There API server — Fastify and SQLite, serving the client as well",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "dev": "node --watch --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@owl/shared": "*",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  }
}
