# Only what the build needs. Everything else would invalidate the layer cache
# or, worse, end up in the image.
**/node_modules
**/dist
**/coverage
**/test
.git
.github
.githooks
e2e
docs
scripts
# The client build precompresses its output with this one.
!scripts/precompress.ts
playwright-report
test-results
data
*.md
# Root-anchored patterns only match at the top; these must not slip in from a
# package directory either.
**/*.db
**/*.db-*
**/.env*
**/*.pem
**/*.key
